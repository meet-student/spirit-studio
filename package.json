{
  "name": "agent-evaluation-platform",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.29.2",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "node server.mjs",
    "dev:web": "pnpm --filter @eval/studio dev",
    "build:ui": "pnpm --filter @mastra/playground-ui exec vite build --mode development",
    "build": "pnpm run build:ui && pnpm --filter @eval/studio build",
    "typecheck": "pnpm --filter @eval/studio typecheck"
  }
}
