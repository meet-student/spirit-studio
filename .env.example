# Official Studio source runs here.
PORT=7337

# The local server-side proxy. It injects the private Mastra key.
MASTRA_PROXY_PORT=4111
MASTRA_API_PREFIX=/internal/mastra

# Sibling business project and its local API.
DRAMA_AGENT_ROOT=../drama-agent
DRAMA_AGENT_API_URL=http://127.0.0.1:7818
APP_ENV=local
